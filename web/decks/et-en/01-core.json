    "note": "Estonian has no verb 'to have': 'I have' is 'mul on' (lit. 'on me is').",
    "examples": [
      {"et": "Ma {olen} täna kodus.", "en": "I [am] at home today.", "form": "pres 1sg"},
      {"et": "Eile {oli} väga külm.", "en": "Yesterday it [was] very cold.", "form": "past 3sg"},
      {"et": "Mul {on} kaks venda.", "en": "I [have] two brothers.", "form": "pres 3sg"},
      {"et": "Ma tahan sinuga koos {olla}.", "en": "I want [to be] with you.", "form": "da-inf"}
    ]
  },
